# ==============================================================================
# Dexa Consult - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and configure with your production credentials.
# NEVER commit real credentials or .env files to GitHub.

# Server Configuration
PORT=4000
NODE_ENV=production

# Frontend Public Base URL (Used for generating clickable reset links in emails)
# Production GitHub Pages URL: https://rkhero01.github.io/dexa-consult
# Local Development: http://localhost:4000
FRONTEND_URL=https://rkhero01.github.io/dexa-consult

# ------------------------------------------------------------------------------
# Transactional Email Provider (Resend)
# ------------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
EMAIL_PROVIDER=resend
EMAIL_FROM=Dexa Consult <onboarding@resend.dev>
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# Alternative: SMTP Provider (Optional fallback)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-password
